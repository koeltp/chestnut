# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android 构建缓存与本机配置（SDK 路径因机器而异）
/android/.gradle/
/android/local.properties
/android/app/.cxx/

# 签名密钥与密码（绝不提交：泄漏需更换发布证书）
android/key.properties
android/*.jks
android/*.keystore

# 环境变量文件（可能含第三方服务密钥）
.env
.env.*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 本机数据库调试副本（含真实账目与位置，严禁入库）
backup_local/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
